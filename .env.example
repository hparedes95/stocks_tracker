# Copia este fichero a .env y rellena lo que vayas a usar.
# NUNCA subas .env al repositorio: esta en .gitignore.

# --- Datos macro (opcional; sin esto la pagina de macro queda vacia) ---
# Clave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Noticias y sentimiento (opcional) ---
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# --- Alertas (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# --- Bot de trading (fases posteriores; ver docs/02 y docs/03) ---
# Las claves de bróker se configuran con `make setup-broker`, no a mano.
