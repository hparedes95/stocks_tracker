# Copia este fichero a `.env` (en la misma carpeta) y rellena lo que uses.
# NUNCA lo subas a ningun sitio: esta en .gitignore.
#
# Para ver que falta y como conseguirlo:
#     .venv\Scripts\python.exe -m stocks_tracker.core.secrets
#
# Lo que no rellenes simplemente no se usa; el dashboard funciona sin nada.

# ===========================================================================
# Opcional: enriquece el dashboard
# ===========================================================================

# Series macro (tipos, inflacion, paro). Gratuita:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Avisos al movil. Crea un bot hablando con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Avisos por correo (alternativa a Telegram).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ===========================================================================
# Bot de trading. Solo hacen falta para OPERAR.
# El estudio y la validacion funcionan sin ninguna de estas.
# ===========================================================================

# --- Kraken (cripto) ------------------------------------------------------
# Kraken > Settings > API > Add key.
#
# PERMISOS: marca solo "Query Funds", "Query Open/Closed Orders" y
# "Create & Modify Orders". Deja SIN MARCAR "Withdraw Funds": esa casilla es
# la que separa una clave robada que hace operaciones absurdas de una cuenta
# vaciada. Tampoco actives margen ni futuros.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Polymarket (mercados de prediccion) ----------------------------------
# En Polymarket cada orden va firmada con la clave privada de la wallet, asi
# que el programa necesita poder firmar en tu nombre.
#
# AQUI NO EXISTE el equivalente a "clave sin permiso de retirada". Quien tenga
# esta clave se lleva todo lo que haya en esa wallet, sin soporte al que
# reclamar ni transaccion que revertir.
#
# Usa una wallet NUEVA, solo para el bot, con el dinero que le asignes y nada
# mas. Si alguna vez se filtra, rotarla no sirve: hay que mover los fondos.
POLYMARKET_PRIVATE_KEY=

# Direccion que aporta el USDC si operas con wallet delegada (la que ves en tu
# perfil de Polymarket). Opcional.
POLYMARKET_FUNDER_ADDRESS=
