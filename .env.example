# Copia este fichero a `.env` (en la misma carpeta) y rellena lo que uses.
# NUNCA lo subas a ningun sitio: esta en .gitignore.
#
# Para ver que falta y como conseguirlo:
#     .venv\Scripts\python.exe -m stocks_tracker.core.secrets
#
# Lo que no rellenes simplemente no se usa; el dashboard funciona sin nada.

# ===========================================================================
# Opcional: enriquece el dashboard
# ===========================================================================

# Series macro (tipos, inflacion, paro). Gratuita:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Avisos al movil. Crea un bot hablando con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Avisos por correo (alternativa a Telegram).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# ===========================================================================
# Bot de trading. Solo hacen falta para OPERAR.
# El estudio y la validacion funcionan sin ninguna de estas.
# ===========================================================================

# --- Kraken (cripto) ------------------------------------------------------
# Kraken > Settings > API > Add key.
#
# PERMISOS: marca solo "Query Funds", "Query Open/Closed Orders" y
# "Create & Modify Orders". Deja SIN MARCAR "Withdraw Funds": esa casilla es
# la que separa una clave robada que hace operaciones absurdas de una cuenta
# vaciada. Tampoco actives margen ni futuros.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Polymarket (mercados de prediccion) ----------------------------------
# En Polymarket cada orden va firmada con la clave privada de la wallet, asi
# que el programa necesita poder firmar en tu nombre.
#
# AQUI NO EXISTE el equivalente a "clave sin permiso de retirada". Quien tenga
# esta clave se lleva todo lo que haya en esa wallet, sin soporte al que
# reclamar ni transaccion que revertir.
#
# Usa una wallet NUEVA, solo para el bot, con el dinero que le asignes y nada
# mas. Si alguna vez se filtra, rotarla no sirve: hay que mover los fondos.
POLYMARKET_PRIVATE_KEY=

# Direccion que aporta el USDC si operas con wallet delegada (la que ves en tu
# perfil de Polymarket). Opcional.
POLYMARKET_FUNDER_ADDRESS=

# Twelve Data: TERCERA fuente de precios, solo para la auditoria cruzada.
#
# Con dos fuentes que discrepan no hay forma de saber cual falla y el veredicto
# es "invalido". Con tres, dos que concuerden hacen mayoria y la discrepante
# queda nombrada. Ese salto es lo que convierte el consenso en algo que ademas
# resuelve, y no solo detecta.
#
# Cuenta gratuita en twelvedata.com: 800 peticiones al dia, 8 por minuto. Da de
# sobra para cartera + senales + muestra; NO da para el universo completo.
#
# Sin esta linea el programa funciona igual, con dos fuentes en vez de tres.
# TWELVE_DATA_API_KEY=

# SEC EDGAR: NO esta implementada, y no es un olvido.
#
# Hubo un modulo `sec_provider.py` y se quito a proposito. Se escribio sin
# salida a internet, asi que sus tests comprobaban que interpretaba bien la
# forma de respuesta que la SEC DOCUMENTA, no la que la SEC DEVUELVE. Quince
# tests en verde que no demostraban nada sobre el mundo, que es exactamente el
# verde-sin-ganar contra el que va este proyecto.
#
# La diferencia con Twelve Data de arriba, que tiene el mismo defecto de origen:
# aquel esta en el registro de proveedores y el panel de integridad lo pinta de
# GRIS ("configurado pero sin comprobar") hasta que sirve una fila de verdad. La
# SEC no tenia quien la pintara de gris, asi que su codigo sin verificar no
# estaba marcado como tal en ningun sitio.
#
# Cuando haya salida a internet, se recupera con `git revert` y se verifica el
# mapeo XBRL contra unas cuantas cuentas anuales reales antes de conectarlo a
# nada. Lo que aportaba y no da nadie mas es la FECHA DE PUBLICACION de cada
# dato: sin ella, un backtest de factores fundamentales mira el futuro.
